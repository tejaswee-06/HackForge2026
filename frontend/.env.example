# Data source: 'api' (default, the integrated ASTRA backend) or 'fixtures' (original UI fixtures, labelled UI FIXTURE).
VITE_ASTRA_DATA_SOURCE=api
# Leave empty to use the Vite dev/preview proxy (same-origin /api and /health -> ASTRA_BACKEND_URL).
# Set to a full origin (e.g. http://127.0.0.1:8000) only if you serve the built files elsewhere;
# that origin must be listed in the backend's ASTRA_CORS_ORIGINS.
VITE_ASTRA_API_BASE_URL=
# Proxy target used by `npm run dev` / `npm run preview` (server-side only, not bundled).
ASTRA_BACKEND_URL=http://127.0.0.1:8000
# Never put provider keys in VITE_* variables: they are embedded in the browser bundle.
