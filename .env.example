# ASTRA backend configuration. Copy to .env (never commit .env). The start scripts pass it to uvicorn
# with --env-file. Every variable is optional: with no .env the fully offline SYNTHETIC demo runs.

# --- Person 1: live blockchain provider (Etherscan V2 indexed API) - server-side only -------------
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ASTRA_PROVIDER_TIMEOUT_S=10
ASTRA_PROVIDER_MAX_RETRIES=3
ASTRA_PROVIDER_BACKOFF_S=0.5
ASTRA_CACHE_TTL_SECONDS=300
ASTRA_SUPPORTED_CHAINS=1
ASTRA_MAX_WALLET_TRANSFERS=500

# --- Live OSINT collection (GitHub REST issue search). Disabled unless set to 1 -------------------
ASTRA_OSINT_GITHUB_ENABLED=0
# Optional; raises GitHub's search rate limit. Use a fine-grained token with NO repository permissions.
GITHUB_TOKEN=

# --- API / limits -------------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS ('*' is ignored on purpose).
ASTRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ASTRA_MAX_INVESTIGATIONS=200
# Seeds used by GET /api/evaluation (labelled synthetic benchmark computed on demand)
ASTRA_EVALUATION_SEEDS=1,2,3,4,5
# ASTRA_DATA_DIR=/absolute/path/to/data   (defaults to ./data)
